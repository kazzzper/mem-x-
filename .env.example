# mem-x Docker configuration — copy to .env and edit.

# Server port (listens on this inside the container and publishes it).
MEMX_PORT=6379

# Requirepass: every connection must AUTH with this password (URL password).
# Leave empty for no authentication.
MEMX_PASSWORD=

# TLS: set to 1 to serve memxs:// (needs MEMX_TLS_CERT and MEMX_TLS_KEY).
MEMX_TLS=0
# MEMX_TLS_CERT=/certs/cert.pem
# MEMX_TLS_KEY=/certs/key.pem

# Persistence (AOF). Set to empty to disable.
MEMX_AOF=/data/appendonly.aof
MEMX_APPENDFSYNC=everysec

# Log level: debug|info|warn|error.
MEMX_LOG_LEVEL=info

# TLS cert verification in the healthcheck (1 = skip, for self-signed certs).
MEMX_TLS_SKIP_VERIFY=0
